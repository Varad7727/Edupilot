
const mongoose = require("mongoose");
const lessonModel = require("../model/lesson.model.js");
const chapterModel = require("../model/chapter.model.js");

// Fields allowed in a lesson create/update request.
const editableFields = [
    "title",
    "description",
    "order",
    "estimatedDuration",
    "difficulty",
    "learningObjectives",
    "topics",
    "tags",
    "prerequisites",
    "aiContext"
];

const isValidString = (value, min, max) =>
    typeof value === "string" &&
    value.trim().length >= min &&
    value.trim().length <= max;

const sendError = (res, error, message) => {
    console.error(message, error);

    if (error.code === 11000) {
        return res.status(409).json({
            status: "failed",
            message: "This lesson order is already used in the chapter."
        });
    }

    if (error.name === "ValidationError" ||
        error.name === "CastError") {
        return res.status(400).json({
            status: "failed",
            message: "Invalid lesson data."
        });
    }

    return res.status(500).json({
        status: "failed",
        message: "Something went wrong while processing the lesson."
    });
};

// Verify that a chapter belongs to the authenticated teacher.
const getOwnedChapter = async (chapterId, teacherId) => {
    return chapterModel.findOne({
        _id: chapterId,
        createdBy: teacherId,
        isArchived: false
    });
};

// CREATE LESSON
const createLesson = async (req, res) => {
    try {
        const {
            title,
            description,
            chapterId,
            order,
            estimatedDuration,
            difficulty,
            learningObjectives,
            topics,
            tags,
            prerequisites,
            aiContext
        } = req.body;

        if (!title || !chapterId || order === undefined) {
            return res.status(400).json({
                status: "failed",
                message: "Title, chapterId and order are required."
            });
        }

        if (!isValidString(title, 3, 150)) {
            return res.status(400).json({
                status: "failed",
                message: "Title must contain 3 to 150 characters."
            });
        }

        if (!mongoose.isValidObjectId(chapterId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid chapter ID."
            });
        }

        if (!Number.isInteger(order) || order < 1) {
            return res.status(400).json({
                status: "failed",
                message: "Order must be a positive integer."
            });
        }

        if (
            description !== undefined &&
            (typeof description !== "string" ||
                description.length > 2000)
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Description must not exceed 2000 characters."
            });
        }

        if (
            estimatedDuration !== undefined &&
            (!Number.isFinite(estimatedDuration) ||
                estimatedDuration < 0)
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Estimated duration must be a non-negative number."
            });
        }

        if (
            difficulty !== undefined &&
            !["beginner", "intermediate", "advanced"].includes(difficulty)
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid difficulty."
            });
        }

        const chapter = await getOwnedChapter(
            chapterId,
            req.teacher._id
        );

        if (!chapter) {
            return res.status(404).json({
                status: "failed",
                message: "Chapter not found or access denied."
            });
        }

        // Prerequisites must be valid, existing lessons.
        if (prerequisites !== undefined) {
            if (!Array.isArray(prerequisites)) {
                return res.status(400).json({
                    status: "failed",
                    message: "Prerequisites must be an array."
                });
            }

            if (prerequisites.some(
                id => !mongoose.isValidObjectId(id)
            )) {
                return res.status(400).json({
                    status: "failed",
                    message: "A prerequisite lesson ID is invalid."
                });
            }

            const uniqueIds = [...new Set(
                prerequisites.map(String)
            )];

            if (uniqueIds.length !== prerequisites.length) {
                return res.status(400).json({
                    status: "failed",
                    message: "Duplicate prerequisites are not allowed."
                });
            }

            const existingLessons = await lessonModel.countDocuments({
                _id: { $in: prerequisites },
                createdBy: req.teacher._id,
                isArchived: false
            });

            if (existingLessons !== prerequisites.length) {
                return res.status(400).json({
                    status: "failed",
                    message: "One or more prerequisite lessons do not exist or are inaccessible."
                });
            }
        }

        const lesson = await lessonModel.create({
            title: title.trim(),
            description: description?.trim() || "",
            chapterId: chapter._id,
            createdBy: req.teacher._id,
            order,
            estimatedDuration,
            difficulty,
            learningObjectives,
            topics,
            tags,
            prerequisites,
            aiContext
        });

        return res.status(201).json({
            status: "success",
            message: "Lesson created successfully.",
            data: lesson
        });

    } catch (error) {
        return sendError(res, error, "Create lesson error:");
    }
};

// GET ALL LESSONS CREATED BY TEACHER
const getMyLessons = async (req, res) => {
    try {
        const {
            chapterId,
            status,
            search,
            page = 1,
            limit = 20
        } = req.query;

        const pageNumber = Number(page);
        const pageSize = Number(limit);

        if (
            !Number.isInteger(pageNumber) || pageNumber < 1 ||
            !Number.isInteger(pageSize) ||
            pageSize < 1 || pageSize > 100
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid pagination parameters."
            });
        }

        const filter = {
            createdBy: req.teacher._id,
            isArchived: false
        };

        if (chapterId) {
            if (!mongoose.isValidObjectId(chapterId)) {
                return res.status(400).json({
                    status: "failed",
                    message: "Invalid chapter ID."
                });
            }

            const chapter = await getOwnedChapter(
                chapterId,
                req.teacher._id
            );

            if (!chapter) {
                return res.status(404).json({
                    status: "failed",
                    message: "Chapter not found or access denied."
                });
            }

            filter.chapterId = chapter._id;
        }

        if (status !== undefined) {
            if (!["draft", "published"].includes(status)) {
                return res.status(400).json({
                    status: "failed",
                    message: "Status must be draft or published."
                });
            }

            filter.status = status;
        }

        if (search !== undefined) {
            if (
                typeof search !== "string" ||
                search.trim().length > 100
            ) {
                return res.status(400).json({
                    status: "failed",
                    message: "Search must not exceed 100 characters."
                });
            }

            filter.title = {
                $regex: search.trim().replace(
                    /[.*+?^${}()|[\]\\]/g,
                    "\\$&"
                ),
                $options: "i"
            };
        }

        const [lessons, total] = await Promise.all([
            lessonModel.find(filter)
                .populate("chapterId", "title subjectId order")
                .populate("prerequisites", "title order")
                .sort({ chapterId: 1, order: 1 })
                .skip((pageNumber - 1) * pageSize)
                .limit(pageSize)
                .lean(),

            lessonModel.countDocuments(filter)
        ]);

        return res.status(200).json({
            status: "success",
            count: lessons.length,
            total,
            page: pageNumber,
            pages: Math.ceil(total / pageSize),
            data: lessons
        });

    } catch (error) {
        return sendError(res, error, "Get lessons error:");
    }
};

// GET ONE LESSON
const getLessonById = async (req, res) => {
    try {
        const { lessonId } = req.params;

        if (!mongoose.isValidObjectId(lessonId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid lesson ID."
            });
        }

        const lesson = await lessonModel.findOne({
            _id: lessonId,
            createdBy: req.teacher._id,
            isArchived: false
        })
            .populate("chapterId", "title subjectId order")
            .populate("prerequisites", "title order")
            .lean();

        if (!lesson) {
            return res.status(404).json({
                status: "failed",
                message: "Lesson not found or access denied."
            });
        }

        return res.status(200).json({
            status: "success",
            data: lesson
        });

    } catch (error) {
        return sendError(res, error, "Get lesson error:");
    }
};

// UPDATE LESSON METADATA
const updateLesson = async (req, res) => {
    try {
        const { lessonId } = req.params;
        const fields = Object.keys(req.body);

        if (!mongoose.isValidObjectId(lessonId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid lesson ID."
            });
        }

        if (
            fields.length === 0 ||
            fields.some(field => !editableFields.includes(field))
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Provide only supported lesson fields."
            });
        }

        const lesson = await lessonModel.findOne({
            _id: lessonId,
            createdBy: req.teacher._id,
            isArchived: false
        });

        if (!lesson) {
            return res.status(404).json({
                status: "failed",
                message: "Lesson not found or access denied."
            });
        }

        const updates = { ...req.body };

        if (updates.title !== undefined) {
            if (!isValidString(updates.title, 3, 150)) {
                return res.status(400).json({
                    status: "failed",
                    message: "Title must contain 3 to 150 characters."
                });
            }

            updates.title = updates.title.trim();
        }

        if (updates.description !== undefined) {
            if (
                typeof updates.description !== "string" ||
                updates.description.length > 2000
            ) {
                return res.status(400).json({
                    status: "failed",
                    message: "Invalid description."
                });
            }

            updates.description = updates.description.trim();
        }

        if (updates.order !== undefined &&
            (!Number.isInteger(updates.order) ||
                updates.order < 1)) {
            return res.status(400).json({
                status: "failed",
                message: "Order must be a positive integer."
            });
        }

        if (
            updates.estimatedDuration !== undefined &&
            (!Number.isFinite(updates.estimatedDuration) ||
                updates.estimatedDuration < 0)
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid estimated duration."
            });
        }

        if (
            updates.difficulty !== undefined &&
            !["beginner", "intermediate", "advanced"]
                .includes(updates.difficulty)
        ) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid difficulty."
            });
        }

        if (updates.prerequisites !== undefined) {
            if (!Array.isArray(updates.prerequisites) ||
                updates.prerequisites.some(
                    id => !mongoose.isValidObjectId(id)
                )) {
                return res.status(400).json({
                    status: "failed",
                    message: "Invalid prerequisites."
                });
            }

            if (updates.prerequisites.some(
                id => String(id) === String(lesson._id)
            )) {
                return res.status(400).json({
                    status: "failed",
                    message: "A lesson cannot be its own prerequisite."
                });
            }

            const ids = [...new Set(
                updates.prerequisites.map(String)
            )];

            if (ids.length !== updates.prerequisites.length) {
                return res.status(400).json({
                    status: "failed",
                    message: "Duplicate prerequisites are not allowed."
                });
            }

            const count = await lessonModel.countDocuments({
                _id: { $in: ids },
                createdBy: req.teacher._id,
                isArchived: false
            });

            if (count !== ids.length) {
                return res.status(400).json({
                    status: "failed",
                    message: "A prerequisite is missing or inaccessible."
                });
            }

            updates.prerequisites = ids;
        }

        // When source content changes, future AI indexing must
        // be refreshed. A worker will perform actual processing.
        const aiRelevantFields = [
            "title",
            "description",
            "learningObjectives",
            "topics",
            "tags",
            "aiContext"
        ];

        const aiRelevantChange = aiRelevantFields.some(
            field => updates[field] !== undefined
        );

        if (aiRelevantChange) {
            updates.$set = {
                ...updates
            };

            delete updates.$set.contentVersion;
            delete updates.contentVersion;

            updates.$set.contentVersion = lesson.contentVersion + 1;
            updates.$set["aiProcessing.status"] = "stale";
            updates.$set["aiProcessing.lastError"] = null;

            delete updates.title;
            delete updates.description;
            delete updates.learningObjectives;
            delete updates.topics;
            delete updates.tags;
            delete updates.aiContext;
            delete updates.order;
            delete updates.estimatedDuration;
            delete updates.difficulty;
            delete updates.prerequisites;
        }

        const updatedLesson = await lessonModel.findOneAndUpdate(
            {
                _id: lessonId,
                createdBy: req.teacher._id,
                isArchived: false
            },
            { $set: updates.$set || updates },
            {
                returnDocument: "after",
                runValidators: true
            }
        );

        return res.status(200).json({
            status: "success",
            message: "Lesson updated successfully.",
            data: updatedLesson
        });

    } catch (error) {
        return sendError(res, error, "Update lesson error:");
    }
};

// PUBLISH LESSON
const publishLesson = async (req, res) => {
    try {
        const { lessonId } = req.params;

        if (!mongoose.isValidObjectId(lessonId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid lesson ID."
            });
        }

        const lesson = await lessonModel.findOne({
            _id: lessonId,
            createdBy: req.teacher._id,
            isArchived: false
        });

        if (!lesson) {
            return res.status(404).json({
                status: "failed",
                message: "Lesson not found or access denied."
            });
        }

        if (!lesson.title || !lesson.chapterId) {
            return res.status(400).json({
                status: "failed",
                message: "Lesson is missing required content."
            });
        }

        lesson.status = "published";
        lesson.publishedAt = new Date();

        await lesson.save();

        return res.status(200).json({
            status: "success",
            message: "Lesson published successfully.",
            data: lesson
        });
        
        
    } catch (error) {
        return sendError(res, error, "Publish lesson error:");
    }
};

// UNPUBLISH LESSON
const unpublishLesson = async (req, res) => {
    try {
        const { lessonId } = req.params;

        if (!mongoose.isValidObjectId(lessonId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid lesson ID."
            });
        }

        const lesson = await lessonModel.findOneAndUpdate(
            {
                _id: lessonId,
                createdBy: req.teacher._id,
                isArchived: false
            },
            {
                $set: {
                    status: "draft",
                    publishedAt: null
                }
            },
            {
                returnDocument: "after",
                runValidators: true
            }
        );

        if (!lesson) {
            return res.status(404).json({
                status: "failed",
                message: "Lesson not found or access denied."
            });
        }

        return res.status(200).json({
            status: "success",
            message: "Lesson moved to draft.",
            data: lesson
        });

    } catch (error) {
        return sendError(res, error, "Unpublish lesson error:");
    }
};

// ARCHIVE LESSON
const archiveLesson = async (req, res) => {
    try {
        const { lessonId } = req.params;

        if (!mongoose.isValidObjectId(lessonId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid lesson ID."
            });
        }

        const lesson = await lessonModel.findOneAndUpdate(
            {
                _id: lessonId,
                createdBy: req.teacher._id,
                isArchived: false
            },
            {
                $set: {
                    isArchived: true,
                    status: "draft",
                    publishedAt: null
                }
            },
            {
                returnDocument: "after",
                runValidators: true
            }
        );

        if (!lesson) {
            return res.status(404).json({
                status: "failed",
                message: "Lesson not found or already archived."
            });
        }

        return res.status(200).json({
            status: "success",
            message: "Lesson archived successfully.",
            data: lesson
        });

    } catch (error) {
        return sendError(res, error, "Archive lesson error:");
    }
};

// LIST LESSONS INSIDE A CHAPTER
const getLessonsByChapter = async (req, res) => {
    try {
        const { chapterId } = req.params;

        if (!mongoose.isValidObjectId(chapterId)) {
            return res.status(400).json({
                status: "failed",
                message: "Invalid chapter ID."
            });
        }

        const chapter = await getOwnedChapter(
            chapterId,
            req.teacher._id
        );

        if (!chapter) {
            return res.status(404).json({
                status: "failed",
                message: "Chapter not found or access denied."
            });
        }

        const lessons = await lessonModel.find({
            chapterId: chapter._id,
            createdBy: req.teacher._id,
            isArchived: false
        })
            .sort({ order: 1 })
            .lean();

        return res.status(200).json({
            status: "success",
            count: lessons.length,
            data: lessons
        });

    } catch (error) {
        return sendError(res, error, "Get chapter lessons error:");
    }
};

module.exports = {
    createLesson,
    getMyLessons,
    getLessonById,
    updateLesson,
    publishLesson,
    unpublishLesson,
    archiveLesson,
    getLessonsByChapter
};
